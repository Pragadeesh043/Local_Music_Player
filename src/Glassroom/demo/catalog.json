  "lyrics": [
    {
      "at": 0,
      "text": "Out where the water meets the sky"
    },
    {
      "at": 12,
      "text": "The shoreline gathers up the light"
    },
    {
      "at": 24,
      "text": "We let the silence drift between us"
    },
    {
      "at": 38,
      "text": "And leave our names beneath the tide"
    },
    {
      "at": 53,
      "text": "There’s a light beyond the headland"
    },
    {
      "at": 69,
      "text": "There’s a place the waves can hide"
    },
    {
      "at": 85,
      "text": "When the harbor falls to quiet"
    },
    {
      "at": 102,
      "text": "I’ll be waiting on the other side"
    },
    {
      "at": 125,
      "text": "Out where the water meets the sky"
    },
    {
      "at": 148,
      "text": "The shoreline gives back all the light"
    },
    {
      "at": 175,
      "text": "We let the silence drift between us"
    },
    {
      "at": 207,
      "text": "And leave our names beneath the tide"
