<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>MP4A</AssemblyName>
    <Product>MP4A</Product>
    <Version>1.0.3</Version>
    <ApplicationIcon>Assets\MP4A.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <FFmpegDirectory Condition="'$(FFmpegDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\.tools\ffmpeg</FFmpegDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\MP4A.Web\dist\**\*" Link="Glassroom\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\MP4A.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(FFmpegDirectory)\ffmpeg.exe;$(FFmpegDirectory)\ffprobe.exe;$(FFmpegDirectory)\*.dll;$(FFmpegDirectory)\LICENSE*;$(FFmpegDirectory)\COPYING*;$(FFmpegDirectory)\README*"
             Condition="Exists('$(FFmpegDirectory)\ffmpeg.exe') And Exists('$(FFmpegDirectory)\ffprobe.exe')"
             Link="Tools\FFmpeg\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260804001" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.provider.winsqlite3" Version="2.1.11" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <Content Include="Native\phonon.dll" Condition="Exists('Native\phonon.dll')">
      <Link>phonon.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Native\SteamAudio-*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Native\SACD\UPSTREAM.md" Link="Tools\SACD\UPSTREAM.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireBundledFFmpeg" BeforeTargets="PrepareForBuild"
          Condition="'$(RequireFFmpeg)' == 'true' Or ('$(WindowsPackageType)' != '' And '$(WindowsPackageType)' != 'None')">
    <Error Condition="!Exists('$(FFmpegDirectory)\ffmpeg.exe') Or !Exists('$(FFmpegDirectory)\ffprobe.exe')"
           Text="Supply ffmpeg.exe and ffprobe.exe in .tools\ffmpeg or set the FFmpegDirectory MSBuild property." />
  </Target>
</Project>
